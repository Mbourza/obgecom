# Master kill switch
AI_CONFIRMATION_ENABLED=1

# Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyAEkhAORAoVt8UYNMwkr9IkaqRUhOQnpuI
GEMINI_MODEL=gemini-1.5-flash
AI_REQUEST_TIMEOUT_SECONDS=15

# Queue
AI_CONFIRMATION_QUEUE_DRIVER=db
AI_CONFIRMATION_POLL_INTERVAL_MS=1000
AI_CONFIRMATION_STALE_CLAIM_MINUTES=10
AI_CONFIRMATION_MAX_ATTEMPTS=3

# Confirmation defaults
AI_CONFIRMATION_DEFAULT_TIMEOUT_MINUTES=120
AI_CONFIRMATION_DEFAULT_SECOND_TIMEOUT_MINUTES=120
AI_CONFIRMATION_DEFAULT_MAX_AI_REPLIES=3
AI_CONFIRMATION_DEFAULT_CONFIRM_THRESHOLD=0.85
AI_CONFIRMATION_DEFAULT_CANCEL_THRESHOLD=0.85
AI_CONFIRMATION_DEFAULT_AGENT_FALLBACK_ENABLED=1
AI_CONFIRMATION_DEFAULT_AUTO_SHIPPING_ENABLED=1

# Webhook verification
WHATSAPP_WEBHOOK_SECRET=          # optional; usually leave empty for 360dialog
WHATSAPP_PROVIDER=360dialog
WHATSAPP_DEFAULT_TEMPLATE_NAME=order_confirmation_ai
WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=fr
WHATSAPP_WEBHOOK_MODE= none

# Logging
AI_CONFIRMATION_LOG_LEVEL=info
AI_CONFIRMATION_LOG_FILE=ai_confirmation/logs/worker.log
AI_CONFIRMATION_LOG_TO_ERROR_LOG=1

# Worker
AI_CONFIRMATION_WORKER_ID_PREFIX=
AI_CONFIRMATION_WORKER_MAX_JOBS=1000
AI_CONFIRMATION_WORKER_SHUTDOWN_TIMEOUT=30

# Rate limiting
AI_CONFIRMATION_MAX_WHATSAPP_PER_MINUTE=60
AI_CONFIRMATION_MAX_AI_CALLS_PER_MINUTE=30

# Testing
AI_CONFIRMATION_USE_MOCKS=0